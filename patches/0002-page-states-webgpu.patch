+// dolphin-browser: `navigator.gpu` exists in browsers that then hand out no adapter
+// (no GPU, a blocklisted driver, a headless or remote session); the hardware renderer
+// would fail at init. One probe, kept for the page's life.
+let webgpuProbe = null;
+function webgpuUsable() {
+  if (!navigator.gpu) return Promise.resolve(false);
+  if (!webgpuProbe) {
+    webgpuProbe = navigator.gpu.requestAdapter().then((adapter) => !!adapter).catch(() => false);
+  }
+  return webgpuProbe;
+}
