+// ── dolphin-browser: memory cards and states that survive a reload ───────────────────
+// The worker keeps Dolphin's memory-card files in IndexedDB on its own clock; a page
+// going away asks it for one last write. States saved to a slot are kept here, under
+// the game's id.
+function wireSaveFlush() {
+  const flush = () => {
+    const a = host.adapter;
+    if (!a || typeof a.request !== "function") return;
+    try { a.request("flushSaves", {}).catch(() => {}); } catch { /* no worker yet */ }
+  };
+  window.addEventListener("pagehide", flush);
+  document.addEventListener("visibilitychange", () => { if (document.hidden) flush(); });
+}
+function statesDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open("dolphin-browser", 1);
+    req.onupgradeneeded = () => { const db = req.result; if (!db.objectStoreNames.contains("files")) db.createObjectStore("files"); if (!db.objectStoreNames.contains("states")) db.createObjectStore("states"); };
+    req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error);
+  });
+}
+function stateKey() {
+  const id = host.game?.gameId || host.game?.name || "disc";
+  return `${id}:1`;
+}
+async function saveStateToBrowser() {
+  const a = host.adapter;
+  if (!a || typeof a.saveStateFile !== "function") { setStatus("No core to save from", "error"); return; }
+  setStatus("Saving state… (a few seconds)");
+  try {
+    const r = await a.saveStateFile();
+    if (!r?.bytes) throw new Error(r?.error || "no state produced");
+    const db = await statesDb();
+    await new Promise((resolve, reject) => {
+      const tx = db.transaction("states", "readwrite");
+      tx.objectStore("states").put({ bytes: r.bytes, when: Date.now(), name: host.game?.name || "" }, stateKey());
+      tx.oncomplete = resolve; tx.onerror = () => reject(tx.error);
+    });
+    db.close();
+    setStatus(`State saved in this browser (${formatBytes(r.size)})`);
+  } catch (error) {
+    setStatus(`Save state failed: ${error.message}`, "error");
+  }
+}
+async function loadStateFromBrowser() {
+  const a = host.adapter;
+  if (!a || typeof a.loadStateFile !== "function") { setStatus("No core to load into", "error"); return; }
+  try {
+    const db = await statesDb();
+    const row = await new Promise((resolve, reject) => {
+      const req = db.transaction("states", "readonly").objectStore("states").get(stateKey());
+      req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error);
+    });
+    db.close();
+    if (!row) { setStatus("No state saved for this game in this browser"); return; }
+    setStatus(`Loading state from ${new Date(row.when).toLocaleString()}…`);
+    const r = await a.loadStateFile(new Uint8Array(row.bytes));
+    setStatus(r?.loaded ? "State loaded" : `State load failed (rc=${r?.rc ?? "?"}${r?.error ? " " + r.error : ""})`, r?.loaded ? undefined : "error");
+    syncGameInfo(host.game);
+  } catch (error) {
+    setStatus(`Load state failed: ${error.message}`, "error");
+  }
+}
