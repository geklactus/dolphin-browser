+// ── dolphin-browser: memory cards and the Wii NAND survive a reload ───────────────────
+// Dolphin's user directory is MEMFS; its GCI-folder memory cards are files under
+// /dolphin-user/GC and a Wii game's save lives in the NAND under /dolphin-user/Wii
+// (title/<id>/data/…, with the system files beside it — small, and harmless to keep).
+// They are put back from IndexedDB before a disc boots and written out whenever they
+// change (checked every few seconds, and on request). States saved to a slot go the
+// same way, from the main thread. The NAND's tmp/ is scratch and stays out.
+const SAVES_DIRS = ["/dolphin-user/GC", "/dolphin-user/Wii"];
+const SAVES_SKIP = ["/dolphin-user/Wii/tmp"];
+const SAVES_DB = "dolphin-browser";
+function savesDb() {
+  return new Promise((resolve, reject) => {
+    const req = indexedDB.open(SAVES_DB, 1);
+    req.onupgradeneeded = () => { const db = req.result; if (!db.objectStoreNames.contains("files")) db.createObjectStore("files"); if (!db.objectStoreNames.contains("states")) db.createObjectStore("states"); };
+    req.onsuccess = () => resolve(req.result); req.onerror = () => reject(req.error);
+  });
+}
+function savesTx(db, mode, fn) {                     // fn fills a box from the store; resolved when the transaction completes
+  return new Promise((resolve, reject) => {
+    const tx = db.transaction("files", mode), box = { result: null };
+    fn(tx.objectStore("files"), box);
+    tx.oncomplete = () => resolve(box.result); tx.onerror = () => reject(tx.error); tx.onabort = () => reject(tx.error);
+  });
+}
+const savesSeen = new Map();                           // path → "size:mtime" as last written out
+function walkFs(fs, dir, out = []) {
+  let names = [];
+  try { names = fs.readdir(dir); } catch { return out; }
+  for (const name of names) {
+    if (name === "." || name === "..") continue;
+    const path = `${dir}/${name}`;
+    let st; try { st = fs.stat(path); } catch { continue; }
+    if (fs.isDir(st.mode)) { if (!SAVES_SKIP.includes(path)) walkFs(fs, path, out); }
+    else out.push({ path, size: st.size, mtime: Number(st.mtime) || 0 });
+  }
+  return out;
+}
+async function restoreSaves(fs) {
+  const db = await savesDb();
+  const entries = (await savesTx(db, "readonly", (store, box) => {
+    box.result = [];
+    const cursor = store.openCursor();
+    cursor.onsuccess = () => { const c = cursor.result; if (c) { box.result.push({ path: c.key, bytes: c.value }); c.continue(); } };
+  })) || [];
+  let restored = 0;
+  for (const { path, bytes } of entries) {
+    if (!SAVES_DIRS.some((dir) => path.startsWith(dir + "/"))) continue;
+    try {
+      fs.mkdirTree(path.slice(0, path.lastIndexOf("/")));
+      fs.writeFile(path, bytes);
+      const st = fs.stat(path);
+      savesSeen.set(path, `${st.size}:${Number(st.mtime) || 0}`);
+      restored++;
+    } catch (error) {
+      console.warn(`[saves] could not restore ${path}:`, error);
+    }
+  }
+  db.close();
+  if (restored) console.log(`[saves] ${restored} save file(s) restored from IndexedDB`);
+  return restored;
+}
+async function persistSaves(fs) {
+  const files = SAVES_DIRS.flatMap((dir) => walkFs(fs, dir));
+  const changed = files.filter((f) => savesSeen.get(f.path) !== `${f.size}:${f.mtime}`);
+  const gone = [...savesSeen.keys()].filter((path) => !files.some((f) => f.path === path));
+  if (!changed.length && !gone.length) return 0;
+  const db = await savesDb();
+  await savesTx(db, "readwrite", (store) => {
+    for (const f of changed) store.put(fs.readFile(f.path), f.path);
+    for (const path of gone) store.delete(path);
+  });
+  db.close();
+  for (const f of changed) savesSeen.set(f.path, `${f.size}:${f.mtime}`);
+  for (const path of gone) savesSeen.delete(path);
+  console.log(`[saves] ${changed.length} save file(s) written to IndexedDB${gone.length ? `, ${gone.length} removed` : ""}`);
+  return changed.length + gone.length;
+}
+let savesTimer = null;
+function watchSaves(fs) {
+  if (savesTimer) clearInterval(savesTimer);
+  savesTimer = setInterval(() => { persistSaves(fs).catch((error) => console.warn("[saves]", error)); }, 5000);
+}
